DATABASE_URL="postgresql://recruitment:recruitment_password@localhost:5432/recruitment?schema=public"
APP_NAME="Recruitment"
# Public base URL, used for absolute links in careers structured data (optional).
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Recruitment <notifications@example.com>"
# SMTP is required for public job applications (/careers) email OTP.
# Optional privacy policy link shown with the consent checkbox on the apply form.
PRIVACY_POLICY_URL=""
ENABLE_USER_CSV_EXPORT="false"
